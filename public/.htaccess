# HİS ERP
# Uygulama adresleri "#/" ile çalıştığı için (ör. /dist/#/partiler) sunucu tarafında
# yönlendirme kuralına gerek yoktur; bu dosya hangi klasöre kurulursa kurulsun çalışır.

# Gizli/iç dosyalar web'den indirilemesin
<FilesMatch "^(config\.php|config\.example\.php|\.ftp-deploy-sync-state\.json)$">
  Require all denied
</FilesMatch>

# index.html, service worker ve manifest her zaman taze gelsin (yeni sürüm hemen görünsün)
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|sw\.js|manifest\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
